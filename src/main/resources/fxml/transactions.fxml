<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>

<BorderPane xmlns="http://javafx.com/javafx/17"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.financeapp.controllers.TransactionController">

    <padding>
        <Insets top="10" right="10" bottom="10" left="10"/>
    </padding>

    <top>
        <Label text="Transacciones"
               style="-fx-font-size: 18px; -fx-font-weight: bold;"
               BorderPane.alignment="CENTER_LEFT"/>
    </top>

    <center>
        <ListView fx:id="list" prefHeight="400.0"/>
    </center>

    <bottom>
        <HBox spacing="10" BorderPane.alignment="CENTER_LEFT">
            <padding>
                <Insets top="10"/>
            </padding>

            <children>
                <Button text="Añadir" onAction="#onAdd"/>
                <Button text="Editar" onAction="#onEdit"/>
                <Button text="Eliminar" onAction="#onDelete"/>
            </children>
        </HBox>
    </bottom>

</BorderPane>